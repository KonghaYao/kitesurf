npm_link_all_packages(name = "node_modules")

js_library(
    name = "runtime",
    srcs = glob(["src/*.mjs"]) + ["package.json"],
    deps = [":node_modules/miniflare", ":node_modules/ws"],
)

node_test(
    name = "soak_test",
    size = "enormous",
