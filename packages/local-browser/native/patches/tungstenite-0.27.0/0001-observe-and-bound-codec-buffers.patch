+/// 接收状态快照；零长度 fragment 仍由 Some(0) 表示。
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct ReadBufferState {
+    /// 未消费的输入字节。
+    pub buffered_bytes: usize,
+    /// 当前已解析帧头的完整 payload 长度。
+    pub frame_payload_len: Option<u64>,
+    /// 已合并的 fragment 字节；Some(0) 仍是进行中的消息。
+    pub fragmented_message_bytes: Option<usize>,
+}
+
 impl<Stream> WebSocket<Stream> {
+    /// 返回 codec 当前保留的输入状态，而非上次 I/O 的字节数。
+    pub fn read_buffer_state(&self) -> ReadBufferState {
+        let mut state = self.context.frame.read_buffer_state();
+        state.fragmented_message_bytes = self.context.incomplete.as_ref().map(IncompleteMessage::len);
+        state
+    }
+
+    /// 释放空 backing；不丢弃 header、fragment 或尚未发送的数据。
+    pub fn release_empty_buffers(&mut self) {
+        self.context.frame.release_empty_buffers();
+    }
+
     /// Convert a raw socket into a WebSocket without performing a handshake.
     ///
     /// Call this function if you're using Tungstenite as a part of a web framework
@@ -604,6 +627,9 @@
