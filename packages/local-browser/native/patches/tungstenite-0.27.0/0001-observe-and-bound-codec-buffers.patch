 impl FrameCodec {
+    pub(super) fn read_buffer_state(&self) -> super::ReadBufferState {
+        super::ReadBufferState {
+            buffered_bytes: self.in_buffer.len(),
+            frame_payload_len: self.header.as_ref().map(|(_, len)| *len),
+            fragmented_message_bytes: None,
+        }
+    }
+
+    pub(super) fn release_empty_buffers(&mut self) {
+        if self.in_buffer.is_empty() && self.header.is_none() {
+            self.in_buffer = BytesMut::with_capacity(self.in_buf_max_read);
+        }
+        if self.out_buffer.is_empty() {
+            self.out_buffer = Vec::new();
+        }
+    }
