load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary")
load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@crates_native//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//bazel:checks.bzl", "node_test")
load("//bazel:paths.bzl", "bin_relative", "exec_path")
load("//bazel:rust_checks.bzl", "rust_comments_test", "rust_lint_tests", "rust_nesting_test")

exports_files(glob(["patches/**/*.patch"]) + ["patches/manifest.json"])

js_binary(
    name = "materialize_codec_patches",
    data = glob(["patches/**"]),
    entry_point = "scripts/materialize-codec-patches.mjs",
)

rust_test(
    name = "codec_budget_test",
    size = "small",
    srcs = [
        "src/transport.rs",
        "tests/codec_budget_test.rs",
    ],
    crate_features = ["test-faults"],
    crate_root = "tests/codec_budget_test.rs",
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = [":kitesurf_local_host"] + all_crate_deps(package_name = "", normal = True),
)

rust_test(
    name = "raw_envelope_test",
    size = "small",
    srcs = [
        "src/cdp_raw.rs",
        "src/transport.rs",
        "tests/raw_envelope_test.rs",
    ],
    crate_features = ["test-faults"],
    crate_root = "tests/raw_envelope_test.rs",
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = [":kitesurf_local_host"] + all_crate_deps(package_name = "", normal = True),
)

cargo_toml_env_vars(
    name = "cargo_env",
    src = "Cargo.toml",
)

rust_library(
    name = "kitesurf_local_host",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bundle.rs", "src/main.rs"]),
    crate_name = "kitesurf_local_host",
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = [
        "//packages/local-browser/font-host:kitesurf_font_host",
    ] + all_crate_deps(package_name = "", normal = True),
)

rust_binary(
    name = "kitesurf-native",
    srcs = ["src/main.rs"],
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = [":kitesurf_local_host"] + all_crate_deps(package_name = "", normal = True),
    visibility = ["//visibility:public"],
)

# The embedded crate needs generated inputs. Give its staged sources distinct paths so they
# can coexist with the source checks' copies in the binary output tree.
copy_file(
    name = "embedded_main",
    src = "src/main.rs",
    out = "embedded/main.rs",
)

copy_file(
    name = "embedded_bundle",
    src = "src/bundle.rs",
    out = "embedded/bundle.rs",
)

rust_binary(
    name = "kitesurf",
    srcs = [":embedded_bundle", ":embedded_main"],
    compile_data = [":runtime_bundle"],
    crate_features = ["embedded-runtime"],
    crate_root = ":embedded_main",
    edition = "2021",
    rustc_env = {"KITESURF_RUNTIME_BUNDLE": "$(execpath :runtime_bundle)"},
    rustc_env_files = [":cargo_env"],
    # Keep LLVM optimization off the launcher with the embedded runtime's large static payload.
    rustc_flags = ["-Copt-level=0"],
    deps = [":kitesurf_local_host"] + all_crate_deps(package_name = "", normal = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "bundle_test",
    size = "small",
    srcs = ["src/bundle.rs", "src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = [":kitesurf_local_host"] + all_crate_deps(package_name = "", normal = True),
)

# 与发行二进制相同的源码，只多启用 test-faults；测试注入不进入发行产物。
rust_library(
    name = "kitesurf_local_host_faults",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bundle.rs", "src/main.rs"]) + [
        "tests/actor_pressure.rs",
        "tests/broker_test.rs",
    ],
    crate_name = "kitesurf_local_host",
    crate_features = ["test-faults"],
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = [
        "//packages/local-browser/font-host:kitesurf_font_host",
    ] + all_crate_deps(package_name = "", normal = True),
)

rust_binary(
    name = "kitesurf-native-faults",
    srcs = ["src/main.rs"],
    crate_features = ["test-faults"],
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = [":kitesurf_local_host_faults"] + all_crate_deps(package_name = "", normal = True),
    visibility = ["//packages/local-browser:__pkg__"],
)

rust_binary(
    name = "fake_engine",
    srcs = ["examples/fake_engine.rs"],
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = all_crate_deps(package_name = "", normal = True),
)

# 仅测试使用的 profile 驱动；发行二进制不含该入口。
rust_binary(
    name = "profile_harness",
    srcs = ["examples/profile_harness.rs"],
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = [":kitesurf_local_host"] + all_crate_deps(package_name = "", normal = True),
    visibility = ["//packages/local-browser:__pkg__"],
)

rust_test(
    name = "profile_test",
    size = "small",
    srcs = ["tests/profile_test.rs"],
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = [":kitesurf_local_host"] + all_crate_deps(
        package_name = "",
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "broker_test",
    size = "small",
    args = ["--skip=broker::tests::pressure::"],
    crate = ":kitesurf_local_host_faults",
    crate_features = ["test-faults"],
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = all_crate_deps(
        package_name = "",
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "actor_pressure_test",
    size = "small",
    args = [
        "broker::tests::pressure::",
        "--test-threads=1",
        "--nocapture",
    ],
    crate = ":kitesurf_local_host_faults",
    crate_features = ["test-faults"],
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = all_crate_deps(package_name = "", normal = True, normal_dev = True),
)

rust_test(
    name = "unit_test",
    crate = ":kitesurf_local_host",
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = all_crate_deps(
        package_name = "",
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "supervisor_test",
    size = "small",
    srcs = ["tests/supervisor_test.rs"],
    data = [":fake_engine"],
    edition = "2021",
    env = {"FAKE_ENGINE": "$(rootpath :fake_engine)"},
    rustc_env_files = [":cargo_env"],
    deps = [":kitesurf_local_host"] + all_crate_deps(
        package_name = "",
        normal = True,
        normal_dev = True,
    ),
)

rust_lint_tests(targets = [
    ":bundle_test",
    ":codec_budget_test",
    ":raw_envelope_test",
    ":actor_pressure_test",
    ":broker_test",
    ":fake_engine",
    ":kitesurf-native",
    ":kitesurf-native-faults",
    ":kitesurf_local_host",
    ":kitesurf_local_host_faults",
    ":profile_harness",
    ":profile_test",
    ":supervisor_test",
    ":unit_test",
])

rust_comments_test(
    name = "comments_test",
    srcs = glob([
        "examples/**/*.rs",
        "src/**/*.rs",
        "tests/**/*.rs",
    ]),
)

rust_nesting_test(
    name = "nesting_test",
    srcs = glob([
        "examples/**/*.rs",
        "src/**/*.rs",
        "tests/**/*.rs",
    ]),
)

# 每个受支持宿主只带一个运行时 workerd；测试通过 KITESURF_WORKERD 传入其 rootpath。
# 本地 config_setting：//bazel/rust 的宿主设置无法跨包使用。
[
    config_setting(
        name = host,
        constraint_values = constraints,
    )
    for host, constraints in {
        "linux_aarch64": ["@platforms//cpu:aarch64", "@platforms//os:linux"],
        "linux_x86_64": ["@platforms//cpu:x86_64", "@platforms//os:linux"],
        "macos_aarch64": ["@platforms//cpu:aarch64", "@platforms//os:macos"],
    }.items()
]

filegroup(
    name = "workerd_source",
    srcs = select({
        ":linux_aarch64": ["@workerd_linux_aarch64//:bin/workerd"],
        ":linux_x86_64": ["@workerd_linux_x86_64//:bin/workerd"],
        ":macos_aarch64": ["@workerd_darwin_arm64//:bin/workerd"],
        "//conditions:default": [],
    }),
)

# rules_js 的数据必须能复制进 bin 树，因此外部二进制先复制到本地。
copy_file(
    name = "workerd_bin",
    src = ":workerd_source",
    out = "workerd-bin/workerd",
    is_executable = True,
    visibility = ["//visibility:public"],
)

# 仅用于测试的图像字节：引擎通过 FONT_ASSETS 取用它，冒烟测试检查像素。
filegroup(
    name = "fixture_assets",
    srcs = ["fixtures/pixel.png"],
)

# 合并为单一目录：引擎公共文件，加上 RBI 对、inspector 快照和原生图像 fixture。
copy_to_directory(
    name = "native_assets",
    srcs = [
        ":fixture_assets",
        "//packages/engine:assets",
    ],
    out = "native-assets",
    root_paths = [
        "packages/engine/public",
        "packages/local-browser/native",
    ],
    exclude_srcs_patterns = ["fonts/**"],
    visibility = ["//visibility:public"],
)

js_binary(
    name = "config_generator",
    data = glob(["config/*.mjs"]),
    entry_point = "config/generate.mjs",
)

# Node 只在这里运行：测试消费模块、清单和三个配置。
js_run_binary(
    name = "generated_config",
    srcs = [
        ":native_assets",
        "//packages/engine:local_dist",
    ],
    out_dirs = ["native-config"],
    args = [
        "--assets",
        exec_path(":native_assets"),
        "--dist",
        exec_path("//packages/engine:local_dist"),
        "--out",
        bin_relative("packages/local-browser/native/native-config"),
    ],
    mnemonic = "NativeConfig",
    progress_message = "Generating the native workerd config",
    tool = ":config_generator",
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "release_assets",
    srcs = ["//packages/engine:assets"],
    out = "release-assets",
    root_paths = ["packages/engine/public"],
    exclude_srcs_patterns = ["fonts/**"],
    visibility = ["//packages/local-browser:__pkg__"],
)

js_run_binary(
    name = "release_config",
    srcs = [":cargo_env", ":release_assets", "//packages/engine:local_dist"],
    out_dirs = ["release-config"],
    args = [
        "--release-version-env",
        exec_path(":cargo_env"),
        "--assets",
        exec_path(":release_assets"),
        "--dist",
        exec_path("//packages/engine:local_dist"),
        "--out",
        bin_relative("packages/local-browser/native/release-config"),
    ],
    mnemonic = "NativeConfig",
    tool = ":config_generator",
    visibility = ["//packages/local-browser:__pkg__"],
)

js_binary(
    name = "runtime_bundle_builder",
    entry_point = "scripts/build-runtime-bundle.mjs",
)

js_run_binary(
    name = "runtime_bundle",
    srcs = [":workerd_bin", ":release_config", ":release_assets"],
    outs = ["native-runtime.bin"],
    args = [
        exec_path(":workerd_bin"),
        exec_path(":release_config"),
        exec_path(":release_assets"),
        bin_relative("packages/local-browser/native/native-runtime.bin"),
    ],
    mnemonic = "NativeRuntimeBundle",
    tool = ":runtime_bundle_builder",
    visibility = ["//packages/local-browser:__pkg__"],
)

node_test(
    name = "config_test",
    args = ["config/generate.test.mjs"],
    data = [
        "config/generate.mjs",
        "config/generate.test.mjs",
    ],
)

node_test(
    name = "config_compile_test",
    size = "large",
    timeout = "long",
    args = ["config/config-compile.test.mjs"],
    data = [
        ":generated_config",
        ":native_assets",
        ":workerd_bin",
        "config/config-compile.test.mjs",
    ],
    env = {
        "KITESURF_CONFIG_DIR": "$(rootpath :generated_config)",
        "KITESURF_ENGINE_ASSETS": "$(rootpath :native_assets)",
        "KITESURF_WORKERD": "$(rootpath :workerd_bin)",
    },
)

# 冒烟驱动属于 local-browser 包（随其契约套件一起打包）。
# 该别名保留任务计划指定的 native 包入口名称。
test_suite(
    name = "engine_smoke_test",
    tests = ["//packages/local-browser:engine_smoke_test"],
)

# Node oracle 的兼容测试和 T3 engine 冒烟位于 local-browser 包；这两个别名保留计划
# 指定的 native 入口名称。
test_suite(
    name = "profile_compat_test",
    tests = ["//packages/local-browser:profile_compat_test"],
)

test_suite(
    name = "profile_engine_smoke_test",
    tests = ["//packages/local-browser:profile_engine_smoke_test"],
)
